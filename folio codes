    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --bg-dark: #090D16;
            --card-bg: rgba(15, 23, 42, 0.75);
            --card-border: rgba(255, 255, 255, 0.08);
            --electric-blue: #38bdf8;
            --accent-purple: #818cf8;
            --emerald-accent: #34d399;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }
        html { scroll-behavior: smooth; }
        body { background-color: var(--bg-dark); color: var(--text-main); line-height: 1.6; overflow-x: hidden; }

        /* Background Ambient Glow */
        .glow-sphere {
            position: fixed;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(56, 189, 248, 0.12) 0%, rgba(0,0,0,0) 70%);
            top: -120px;
            left: -120px;
            z-index: -1;
            pointer-events: none;
        }
        .glow-sphere-2 {
            position: fixed;
            width: 550px;
            height: 550px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(129, 140, 248, 0.1) 0%, rgba(0,0,0,0) 70%);
            bottom: -150px;
            right: -120px;
            z-index: -1;
            pointer-events: none;
        }

        /* Floating Navbar */
        nav {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid var(--card-border);
            padding: 0.75rem 2rem;
            border-radius: 50px;
            z-index: 1000;
            display: flex;
            gap: 2rem;
            align-items: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.3s ease;
        }
        nav a:hover { color: var(--electric-blue); }

        /* Layout & Utilities */
        .container { max-width: 1150px; margin: 0 auto; padding: 6rem 2rem 2rem 2rem; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; }
        .grid-skills { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; }

        /* Headers */
        .section-header { text-align: center; margin-bottom: 3.5rem; }
        .section-header h2 { font-size: 2.2rem; margin-bottom: 0.5rem; letter-spacing: -0.02em; }
        .section-header p { color: var(--text-muted); }

        /* Hero Section */
        .hero { min-height: 85vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 8rem 2rem 4rem 2rem; }
        .badge-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(56, 189, 248, 0.1);
            color: var(--electric-blue);
            border: 1px solid rgba(56, 189, 248, 0.3);
            padding: 0.4rem 1.1rem;
            border-radius: 50px;
            font-size: 0.85rem;
            margin-bottom: 1.5rem;
        }
        .hero h1 { font-size: 3.8rem; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 1.5rem; }
        .gradient-text {
            background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero p { max-width: 680px; font-size: 1.2rem; color: var(--text-muted); margin-bottom: 2.5rem; }
        .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }

        /* Interactive Buttons */
        .btn {
            padding: 0.85rem 1.8rem;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 0.95rem;
        }
        .btn-primary {
            background: linear-gradient(135deg, #38bdf8, #6366f1);
            color: white;
            border: none;
            box-shadow: 0 4px 20px rgba(56, 189, 248, 0.3);
        }
        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(56, 189, 248, 0.5);
        }
        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-main);
            border: 1px solid var(--card-border);
            backdrop-filter: blur(10px);
        }
        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--electric-blue);
            transform: translateY(-3px);
        }

        /* Glassmorphism Cards */
        .glass-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 2.2rem;
            backdrop-filter: blur(16px);
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .glass-card:hover {
            transform: translateY(-6px);
            border-color: rgba(56, 189, 248, 0.4);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
        }

        /* Skills Cards */
        .skill-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--card-border);
            padding: 1.6rem;
            border-radius: 14px;
            transition: all 0.3s ease;
        }
        .skill-card:hover {
            border-color: var(--electric-blue);
            background: rgba(56, 189, 248, 0.04);
            transform: translateY(-4px);
        }
        .skill-card-header {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            margin-bottom: 0.75rem;
        }
        .skill-card-header i { font-size: 1.4rem; }
        .skill-card h3 { font-size: 1.15rem; color: #fff; }
        .skill-card p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; }

        /* Project Cards */
        .project-tags { margin-bottom: 1rem; }
        .project-tag {
            background: rgba(56, 189, 248, 0.1);
            color: var(--electric-blue);
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.3rem 0.75rem;
            border-radius: 6px;
            display: inline-block;
            margin-right: 0.4rem;
            margin-bottom: 0.4rem;
        }
        .project-tag.institution {
            background: rgba(129, 140, 248, 0.15);
            color: var(--accent-purple);
            border: 1px solid rgba(129, 140, 248, 0.3);
        }
        .project-card h3 { font-size: 1.35rem; margin-bottom: 0.75rem; color: #fff; }
        .project-card ul { margin-left: 1.2rem; margin-bottom: 1.8rem; color: var(--text-muted); font-size: 0.95rem; }
        .project-card li { margin-bottom: 0.45rem; }
        .project-links { display: flex; gap: 0.8rem; margin-top: auto; }

        /* Contact Section */
        .contact-box {
            text-align: center;
            background: linear-gradient(180deg, rgba(15, 23, 42, 0.6) 0%, rgba(9, 13, 22, 0.9) 100%);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 4.5rem 2rem;
            margin-top: 4rem;
        }
        .contact-socials { display: flex; justify-content: center; gap: 1.5rem; margin-top: 2rem; }
        .social-btn {
